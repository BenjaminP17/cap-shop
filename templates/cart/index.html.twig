{% extends 'base.html.twig' %}

{% block title %}Mon panier · CapShop{% endblock %}

{% block body %}

<div class="announce" aria-label="Annonces">
  <div class="announce__track">
    <span>
      <em style="font-style:normal">▶ LIVRAISON 24H GRATUITE DÈS 60€</em>
      <em class="announce__dot"></em>
      <em style="font-style:normal">CODE <b style="color:var(--coral)">SPRING26</b> · −15% SUR TOUT</em>
      <em class="announce__dot"></em>
      <em style="font-style:normal">RETOURS GRATUITS 30 JOURS</em>
      <em class="announce__dot"></em>
    </span>
    <span aria-hidden="true">
      <em style="font-style:normal">▶ LIVRAISON 24H GRATUITE DÈS 60€</em>
      <em class="announce__dot"></em>
      <em style="font-style:normal">CODE <b style="color:var(--coral)">SPRING26</b> · −15% SUR TOUT</em>
      <em class="announce__dot"></em>
      <em style="font-style:normal">RETOURS GRATUITS 30 JOURS</em>
      <em class="announce__dot"></em>
    </span>
  </div>
</div>

<nav class="nav">
  <div class="nav__inner">
    <a href="{{ path('app_home') }}" class="logo">
      <span class="logo__dot"></span>
      CAP·SHOP
    </a>
    <div class="nav__links">
      <a href="{{ path('app_home') }}#drops">Drops</a>
      <a href="{{ path('app_home') }}#cats">Catégories</a>
      <a href="{{ path('app_home') }}#best">Bestsellers</a>
      <a href="{{ path('app_home') }}#collab">Collabs</a>
      <a href="{{ path('app_home') }}#custom">Custom</a>
      <a href="{{ path('app_home') }}#look">Lookbook</a>
    </div>
    <div class="nav__right">
      <div class="search">
        <span aria-hidden="true">⌕</span>
        <input placeholder="Cherche une casquette…" />
        <span style="opacity:.5">⌘K</span>
      </div>
      <button class="icon-btn" aria-label="Compte">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="12" cy="8" r="3.5"/><path d="M4.5 20c0-4 3.5-6.5 7.5-6.5s7.5 2.5 7.5 6.5"/></svg>
      </button>
      <a href="{{ path('cart_index') }}" class="icon-btn" aria-label="Panier">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 7h14l-1.5 11.5a1.5 1.5 0 0 1-1.5 1.3H8a1.5 1.5 0 0 1-1.5-1.3L5 7z"/><path d="M9 7V5a3 3 0 0 1 6 0v2"/></svg>
        <span class="cart-badge" id="cartBadge">{{ cart_count }}</span>
      </a>
    </div>
  </div>
</nav>

{# ── Page panier ── #}
<main style="min-height: 70vh; background: var(--surface); border-bottom: var(--border-thick);">
  <div class="container" style="padding-top: 60px; padding-bottom: 80px;">

    <div style="margin-bottom: 36px;">
      <span class="sec-eyebrow">🛒 Panier</span>
      <h1 class="sec-title" style="margin-top: 12px;">
        {% if items|length > 0 %}
          {{ cart_count }} article{{ cart_count > 1 ? 's' : '' }} sélectionné{{ cart_count > 1 ? 's' : '' }}
        {% else %}
          Ton panier est <span class="accent-c">vide.</span>
        {% endif %}
      </h1>
    </div>

    {% if items|length == 0 %}
      <div style="text-align:center; padding: 80px 0;">
        <div style="font-size: 72px; margin-bottom: 24px;">🧢</div>
        <p style="font-family:'Space Mono',monospace; font-size: 14px; text-transform: uppercase; opacity: .6; margin-bottom: 28px;">
          Pas encore de casquettes ici.
        </p>
        <a href="{{ path('app_home') }}#drops" class="btn btn--klein">Découvrir les drops →</a>
      </div>
    {% else %}
      <div class="cart-layout">

        {# ── Liste des articles ── #}
        <div class="cart-items" id="cartItems">
          {% for item in items %}
            <div class="cart-row" id="row-{{ item.product.id }}">
              <div class="cart-row__img">
                {% if item.product.imageUrl %}
                  <img src="{{ item.product.imageUrl }}" alt="{{ item.product.name }}" />
                {% else %}
                  <div style="width:100%; height:100%; display:flex; align-items:center; justify-content:center; background:var(--pastel-blue);">
                    <span style="font-size:32px;">🧢</span>
                  </div>
                {% endif %}
              </div>

              <div class="cart-row__info">
                <div class="cart-row__name">{{ item.product.name }}</div>
                <div class="cart-row__brand mono">{{ item.product.brand }} · {{ item.product.category.label() }}</div>
                <div class="cart-row__price-unit">{{ item.product.formattedPrice }} / pièce</div>
              </div>

              <div class="cart-row__qty">
                <button class="qty-btn" data-action="dec" data-id="{{ item.product.id }}" aria-label="Diminuer">−</button>
                <span class="qty-val" id="qty-{{ item.product.id }}">{{ item.quantity }}</span>
                <button class="qty-btn" data-action="inc" data-id="{{ item.product.id }}" aria-label="Augmenter">+</button>
              </div>

              <div class="cart-row__subtotal" id="sub-{{ item.product.id }}">
                {{ '%s €'|format(item.subtotal|number_format(2, ',', ' ')) }}
              </div>

              <button class="cart-row__del" data-id="{{ item.product.id }}" aria-label="Supprimer">✕</button>
            </div>
          {% endfor %}
        </div>

        {# ── Récapitulatif ── #}
        <aside class="cart-summary">
          <div style="font-family:'Space Mono',monospace; font-size:12px; text-transform:uppercase; letter-spacing:.06em; opacity:.6; margin-bottom:16px;">Récapitulatif</div>

          <div class="cart-summary__line">
            <span>Sous-total</span>
            <span id="summarySubtotal">{{ '%s €'|format(total|number_format(2, ',', ' ')) }}</span>
          </div>
          <div class="cart-summary__line">
            <span>Livraison</span>
            <span style="color:var(--green);">
              {% if total >= 60 %}Gratuite{% else %}4,90 €{% endif %}
            </span>
          </div>
          <div class="cart-summary__line cart-summary__line--total">
            <span>Total</span>
            <span id="summaryTotal">
              {% set shipping = total >= 60 ? 0 : 4.90 %}
              {{ '%s €'|format((total + shipping)|number_format(2, ',', ' ')) }}
            </span>
          </div>

          {% if total < 60 %}
            <div style="margin: 14px 0; padding: 10px 14px; background: var(--pastel-yellow); border: var(--border); font-family:'Space Mono',monospace; font-size:11px; text-transform:uppercase;">
              Plus que {{ '%s €'|format((60 - total)|number_format(2, ',', ' ')) }} pour la livraison gratuite !
            </div>
          {% endif %}

          <a href="{{ path('checkout_index') }}" class="btn btn--klein" style="width:100%; justify-content:center; margin-top:20px; display:flex;">
            Commander →
          </a>
          <button class="btn btn--ghost" style="width:100%; justify-content:center; margin-top:10px; font-size:11px;" id="clearCartBtn">
            Vider le panier
          </button>

          <div style="margin-top:20px; display:flex; gap:12px; flex-wrap:wrap; font-family:'Space Mono',monospace; font-size:10px; text-transform:uppercase; opacity:.6;">
            <span>🔒 Paiement sécurisé</span>
            <span>↩ Retours 30j</span>
          </div>
        </aside>

      </div>
    {% endif %}
  </div>
</main>

<footer class="footer" style="padding: 30px 0;">
  <div class="footer__inner">
    <div class="footer__bot" style="opacity:1; border-top: none;">
      <div>© 2026 CAP·SHOP</div>
      <a href="{{ path('app_home') }}" style="color:var(--yellow); font-family:'Space Mono',monospace; font-size:11px; text-transform:uppercase;">← Continuer les achats</a>
    </div>
  </div>
</footer>

{% endblock %}
