{# ── Hero ── #}
<header class="hero">
  <div class="hero__inner">
    <div>
      <div style="display:flex; gap:10px; align-items:center; flex-wrap:wrap; margin-bottom:18px;">
        <span class="mono" style="background:var(--ink); color:var(--yellow); padding:4px 10px; font-size:12px; letter-spacing:0.08em; text-transform:uppercase; border:var(--border);">SS·26 / DROP №14</span>
        <span class="mono" style="background:var(--coral); color:var(--ink); padding:4px 10px; font-size:12px; letter-spacing:0.08em; text-transform:uppercase; border:var(--border); box-shadow:var(--shadow-sm);">LIMITED · 250 PCS</span>
      </div>
      <h1>
        Couvre<br/>
        <span class="hl">ta tête,</span><br/>
        pas tes <span class="ink-bg">vibes.</span>
      </h1>
      <p class="hero__sub">
        Casquettes triées à la main · marques cultes, drops indé, et notre atelier broderie maison.
        Du snapback au bucket — un seul endroit, mille caractères.
      </p>
      <div class="hero__cta-row">
        <a href="#drops" class="btn btn--klein">Voir le drop · €0 livraison →</a>
        <a href="#custom" class="btn btn--ghost">Personnaliser ma casquette</a>
      </div>
      <div class="hero__meta">
        <div><b>4.9/5</b> · 12 800 avis</div>
        <div><b>24H</b> · expédition Paris</div>
        <div><b>+340</b> · modèles dispo</div>
      </div>
    </div>

    <div class="hero__stage" aria-label="Drop de la saison">
      <div class="stage-card r1">
        <span class="stage-tag">SNAPBACK · NEW</span>
        <img
          src="https://images.unsplash.com/photo-1570748092285-6203601e4bcb?w=600&h=600&fit=crop&q=80"
          alt="Snapback cap"
          class="stage-img"
        />
        <span class="stage-price">39€</span>
      </div>
      <div class="stage-card r2">
        <span class="stage-tag">FITTED 7⅜</span>
        <img
          src="https://images.unsplash.com/photo-1591818343198-4ff334074580?w=600&h=600&fit=crop&q=80"
          alt="Fitted cap"
          class="stage-img"
        />
        <span class="stage-price">45€</span>
      </div>
      <div class="stage-card r3">
        <span class="stage-tag">DAD CAP · WASHED</span>
        <img
          src="https://images.unsplash.com/photo-1521369909029-2afed882baee?w=600&h=600&fit=crop&q=80"
          alt="Dad cap"
          class="stage-img"
        />
        <span class="stage-price">32€</span>
      </div>
      <div class="stage-card r4">
        <span class="stage-tag">TRUCKER · MESH</span>
        <img
          src="https://images.unsplash.com/photo-1678721938524-1a3ee398de2a?w=600&h=600&fit=crop&q=80"
          alt="Trucker cap"
          class="stage-img"
        />
        <span class="stage-price">29€</span>
      </div>
      <div class="hero__sticker hero__sticker--bl">
        <div>▶<br/>PLAY<br/>DROP—14</div>
      </div>
    </div>
  </div>
</header>

